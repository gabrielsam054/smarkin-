# ── Supabase ──────────────────────────────────────────────────────────────────
# Required at BUILD TIME on Vercel — add these in Vercel → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── Anthropic (server-side only — never use NEXT_PUBLIC_ prefix) ──────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=Smarkin AI

# ── Paystack (server-side only — never use NEXT_PUBLIC_ prefix) ───────────────
# Get from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_...
# Public key is safe to expose (used only on the landing/pricing pages if needed)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
